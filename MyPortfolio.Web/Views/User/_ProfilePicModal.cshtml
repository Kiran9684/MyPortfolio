@model ProfilePictureUploadViewModel;

<div class="modal fade" id="profilePicModal" tabindex="-1" aria-labelledby="profilePicModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="profilePicModalLabel">Update Profile Picture</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center">
                <img id="imagePreview" src="#" class="img-thumbnail rounded-circle mb-3 shadow-sm" style="width: 150px; height: 150px; object-fit: cover; display: none;" alt="Preview" />

                <form id="profilePicForm" enctype="multipart/form-data">
                    <div class="mb-3 text-start">
                        <label asp-for = "ProfilePicture" class="form-label text-muted small">Choose a new picture (Max 2MB, JPG/PNG only)</label>
                        <input class="form-control" asp-for ="ProfilePicture" accept=".jpg,.jpeg,.png" >
                        <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button> *@
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnUploadProfilePic" data-url=@Url.Action("UploadUserPicture", "User")>Upload</button>
            </div>
        </div>
    </div>
</div>