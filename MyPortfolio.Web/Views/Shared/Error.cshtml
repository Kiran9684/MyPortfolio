@using MyPortfolio.Models.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = "Oops! Something went wrong.";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <i class="fa-solid fa-triangle-exclamation text-warning mb-4" style="font-size: 5rem;"></i>

            <h1 class="display-4 fw-bold mb-3">Oops! System hiccup.</h1>
            <p class="lead text-muted mb-4">
                We're sorry, but it looks like our servers are currently not responding as expected. We have been notified and are looking into it.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-secondary p-3 mb-4 rounded-3 text-start">
                    <p class="mb-1 fw-bold">Support Details:</p>
                    <p class="mb-0 font-monospace text-muted small">
                        Error ID: @Model.RequestId
                    </p>
                    <hr class="my-2" />
                    <p class="mb-0 small">
                        If you need immediate assistance, please
                        <a href="mailto:support@myportfolio.com?subject=Error%20Report%20-%20ID:%20@Model.RequestId" class="text-decoration-none fw-bold">
                            email support
                        </a>
                        and quote the ID above.
                    </p>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                <i class="fa-solid fa-house me-2"></i> Back to Home
            </a>
        </div>
    </div>
</div>
